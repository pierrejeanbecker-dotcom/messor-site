---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { UI } from '../data/site';
import { url } from '../lib/url';
const t = UI.fr;
---
<Base title={`${t.notFound} - Messor`} lang="fr" path="/404">
  <PageHero title={t.notFound} lead={t.notFoundText}>
    <a class="btn" href={url('/')}>{t.backHome}</a>
    <a class="btn-ghost" href={url('/blog')}>Blog</a>
  </PageHero>
</Base>
