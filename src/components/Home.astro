---
import { HOME, CLIENTS } from '../data/home';
import { BOOKING_URL, type Lang } from '../data/site';
import { url } from '../lib/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = HOME[lang];
const bruegel = url('/images/bruegel-les-moissonneurs.webp');
---
<!-- ── HERO ── -->
<section class="hero">
  <div class="layer" style={`background-image:url("${bruegel}");background-position:center 30%;filter:grayscale(.3) contrast(1.05) brightness(.55);opacity:.55`}></div>
  <div class="layer" style="background:linear-gradient(180deg, oklch(11% 0.015 260 / 0.85) 0%, oklch(11% 0.015 260 / 0.65) 40%, oklch(11% 0.015 260 / 0.9) 100%)"></div>
  <div class="layer" style={`background-image:url("${bruegel}");background-position:30% 90%;opacity:.85`}></div>
  <div class="layer" style="background:linear-gradient(95deg, oklch(11% 0.015 260 / 0.95) 0%, oklch(11% 0.015 260 / 0.85) 35%, oklch(11% 0.015 260 / 0.55) 65%, oklch(11% 0.015 260 / 0.3) 100%)"></div>
  <div class="layer" style="background:linear-gradient(180deg, transparent 0%, transparent 60%, var(--dark) 100%)"></div>
  <div class="layer grid"></div>
  <div class="glow"></div>
  <div class="credit">{h.painting[0]}<em>{h.painting[1]}</em>{h.painting[2]}</div>

  <div class="wrap hero-inner">
    <div class="badge"><span class="dot"></span>{h.badge}</div>
    <h1>
      {h.titleStart}{' '}<span class="alt-word" data-words={JSON.stringify(h.altWords)}>{h.altWords[0]}</span>.<br />
      <em>{h.titleHarvest}</em> {h.titleEnd}
    </h1>
    <p class="hero-lead">{h.lead}</p>
    <div class="hero-actions">
      <a class="btn" href={BOOKING_URL} target="_blank" rel="noopener">{h.book}</a>
      <a class="btn-ghost" href="#resultats">{h.seeResults}</a>
    </div>
    <div class="stats">
      {h.stats.map((s) => (
        <div>
          <div class="stat-n">{s.n}</div>
          <div class="stat-l">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── CLIENTS ── -->
<section class="clients">
  <div class="wrap">
    <p class="clients-title">{h.clientsTitle}</p>
    <div class="clients-list">{CLIENTS.map((c) => <span>{c}</span>)}</div>
  </div>
</section>

<!-- ── LE PROBLÈME ── -->
<section class="section bg-paper" style="padding-top:90px;padding-bottom:90px">
  <div class="wrap-narrow">
    <div style="max-width:720px;margin-bottom:56px">
      <p class="eyebrow">{h.problem.eyebrow}</p>
      <h2 class="h2">{h.problem.title}</h2>
    </div>
    <div class="pains">
      {h.problem.pains.map((p) => (
        <div class="pain"><span class="x">✕</span><span>{p}</span></div>
      ))}
    </div>
    <p class="role">
      {h.problem.roleStart}<span>{h.problem.roleKey}</span>{h.problem.roleEnd}
    </p>
  </div>
</section>

<!-- ── OFFRES ── -->
<section id="offres" class="section bg-dark">
  <div class="wrap">
    <div class="offers-head">
      <div style="max-width:640px">
        <p class="eyebrow">{h.offers.eyebrow}</p>
        <h2 class="serif" style="font-size:clamp(32px,4vw,52px);line-height:1.1;letter-spacing:-0.02em;color:white">{h.offers.title}</h2>
      </div>
      <p class="offers-side">{h.offers.side}</p>
    </div>
    <div class="offers">
      {h.offers.items.map((o) => (
        <div class:list={['offer', { highlight: o.highlight }]}>
          <span class="offer-tag">{o.tag}</span>
          <h3>{o.title}</h3>
          <p class="offer-pitch">{o.pitch}</p>
          <ul>{o.deliverables.map((d) => <li><span>✓</span>{d}</li>)}</ul>
          <a href={url(o.href)}>{h.offers.more}</a>
        </div>
      ))}
    </div>
    <p class="offers-foot">
      {h.offers.footStart}<a href={url(h.offers.footLink1.href)}>{h.offers.footLink1.label}</a>{h.offers.footMid}<a href={url(h.offers.footLink2.href)}>{h.offers.footLink2.label}</a>{h.offers.footEnd}
    </p>
  </div>
</section>

<!-- ── PROCESS ── -->
<section id="process" class="section bg-warm">
  <div class="wrap-narrow">
    <div style="max-width:720px;margin-bottom:64px">
      <p class="eyebrow">{h.process.eyebrow}</p>
      <h2 class="serif" style="font-size:clamp(32px,4vw,48px);line-height:1.1;letter-spacing:-0.02em;margin-bottom:20px">
        {h.process.titleStart}<em>{h.process.titleEm}</em>{h.process.titleEnd}
      </h2>
      <p class="muted" style="font-size:16px;line-height:1.65">{h.process.lead}</p>
    </div>
    <div>
      {h.process.steps.map((s) => (
        <div class="step">
          <div class="step-n">{s.n}</div>
          <div>
            <div class="step-delay">{s.delay}</div>
            <div class="step-title">{s.title}</div>
          </div>
          <div class="step-desc">{s.desc}</div>
        </div>
      ))}
      <div style="border-top:1px solid var(--line)"></div>
    </div>
  </div>
</section>

<!-- ── RÉSULTATS ── -->
<section id="resultats" class="section bg-paper">
  <div class="wrap">
    <div style="margin-bottom:56px">
      <p class="eyebrow">{h.results.eyebrow}</p>
      <h2 class="h2">{h.results.title}</h2>
    </div>
    <div class="results">
      {h.results.items.map((r) => (
        <div class="result">
          <div class="r-sector">{r.sector}</div>
          <div class="r-metric">{r.metric}</div>
          <div class="r-label">{r.label}</div>
          <div class="r-note">{r.note}</div>
          <div class="r-client">{r.client}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── POURQUOI MESSOR ── -->
<section id="adn" class="section bg-warm">
  <div class="wrap adn">
    <div class="adn-left">
      <div class="adn-img" style={`background-image:url("${bruegel}")`} role="img" aria-label={h.why.credit[1]}></div>
      <p class="adn-credit">{h.why.credit[0]}<em>{h.why.credit[1]}</em>{h.why.credit[2]}</p>
      <p class="eyebrow">{h.why.eyebrow}</p>
      <h2 class="h2" style="margin-bottom:24px">{h.why.titleStart}<em>{h.why.titleEm}</em>{h.why.titleEnd}</h2>
      <p class="muted" style="line-height:1.7;font-size:15px;margin-bottom:32px">{h.why.text}</p>
      <a class="adn-btn" href={url(h.why.button.href)}>{h.why.button.label}</a>
    </div>
    <div>
      {h.why.points.map((p) => (
        <div class="point">
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── TÉMOIGNAGES ── -->
<section class="section bg-dark">
  <div class="wrap">
    <div class="t-head">
      <div>
        <p class="eyebrow">{h.testimonials.eyebrow}</p>
        <h2 class="serif" style="font-size:clamp(28px,3vw,42px);color:white;letter-spacing:-0.02em">{h.testimonials.title}</h2>
      </div>
      <div style="display:flex;gap:8px">
        <button class="t-arrow" type="button" data-step="-1" aria-label="Précédent">←</button>
        <button class="t-arrow" type="button" data-step="1" aria-label="Suivant">→</button>
      </div>
    </div>
    <div class="t-grid" id="testimonials">
      <div class="t-quote">
        {h.testimonials.items.map((t, i) => (
          <div class="t-slide" hidden={i !== 0}>
            <blockquote>"{t.quote}"</blockquote>
            <div class="t-name">{t.name}</div>
            <div class="t-role">{t.role}</div>
          </div>
        ))}
      </div>
      <div class="t-list">
        {h.testimonials.items.map((t, i) => (
          <button type="button" class:list={['t-item', { active: i === 0 }]} data-index={i}>
            <span class="n">{t.name}</span>
            <span class="r">{t.role}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ── FAQ ── -->
<section class="section bg-paper">
  <div style="max-width:820px;margin:0 auto">
    <p class="eyebrow" style="text-align:center">{h.faq.eyebrow}</p>
    <h2 class="serif" style="font-size:clamp(28px,3.5vw,44px);text-align:center;margin-bottom:56px;letter-spacing:-0.02em">{h.faq.title}</h2>
    <div class="faq">
      {h.faq.items.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Mot qui alterne dans le titre (produit / service)
  const el = document.querySelector<HTMLElement>('.alt-word');
  if (el) {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    let i = 0;
    setInterval(() => {
      el.classList.add('out');
      setTimeout(() => {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.classList.remove('out');
      }, 280);
    }, 2400);
  }

  // Témoignages
  const root = document.getElementById('testimonials');
  if (root) {
    const slides = root.querySelectorAll<HTMLElement>('.t-slide');
    const items = root.querySelectorAll<HTMLElement>('.t-item');
    let idx = 0;
    const show = (n: number) => {
      idx = (n + slides.length) % slides.length;
      slides.forEach((s, j) => (s.hidden = j !== idx));
      items.forEach((b, j) => b.classList.toggle('active', j === idx));
    };
    items.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.index))));
    document.querySelectorAll<HTMLElement>('.t-arrow').forEach((b) =>
      b.addEventListener('click', () => show(idx + Number(b.dataset.step))),
    );
  }
</script>

<style>
  .hero { background: var(--dark); min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 120px var(--gutter) 60px; position: relative; overflow: hidden; }
  .layer { position: absolute; inset: 0; background-size: cover; pointer-events: none; }
  .layer.grid { background-image: linear-gradient(oklch(30% 0.01 255 / 0.12) 1px, transparent 1px), linear-gradient(90deg, oklch(30% 0.01 255 / 0.12) 1px, transparent 1px); background-size: 80px 80px; opacity: 0.5; }
  .glow { position: absolute; top: -200px; right: -200px; width: 600px; height: 600px; border-radius: 50%; background: oklch(72% 0.14 68 / 0.12); filter: blur(80px); pointer-events: none; }
  .credit { position: absolute; bottom: 24px; right: var(--gutter); font-size: 11px; color: oklch(55% 0.01 260); letter-spacing: 0.04em; z-index: 2; }
  .hero-inner { position: relative; }
  .badge { display: inline-flex; align-items: center; gap: 8px; background: oklch(72% 0.14 68 / 0.12); border: 1px solid oklch(72% 0.14 68 / 0.3); color: var(--gold); border-radius: 100px; padding: 5px 14px; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 28px; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  h1 { font-family: var(--font-serif); font-weight: 400; color: white; font-size: clamp(44px, 6vw, 86px); line-height: 1.03; letter-spacing: -0.025em; margin-bottom: 28px; max-width: 960px; }
  h1 em { color: var(--gold); }
  .alt-word { display: inline-block; min-width: 4.5ch; color: var(--gold); transition: opacity 0.28s ease, transform 0.28s ease; }
  .alt-word.out { opacity: 0; transform: translateY(8px); }
  .hero-lead { color: oklch(72% 0.01 260); font-size: clamp(17px, 1.5vw, 20px); max-width: 640px; line-height: 1.6; margin-bottom: 44px; font-weight: 300; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-bottom: 72px; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; padding-top: 44px; border-top: 1px solid var(--line-dark); }
  .stat-n { font-family: var(--font-serif); color: var(--gold); font-size: 34px; line-height: 1; margin-bottom: 8px; }
  .stat-l { color: oklch(60% 0.01 260); font-size: 13px; line-height: 1.4; }
  @media (max-width: 600px) { .credit { left: var(--gutter); right: auto; bottom: 12px; } }

  .clients { background: var(--paper); padding: 56px var(--gutter); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .clients-title { text-align: center; font-size: 12px; color: var(--ink-muted); letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500; margin-bottom: 28px; }
  .clients-list { display: flex; flex-wrap: wrap; gap: 16px 40px; justify-content: center; align-items: center; }
  .clients-list span { font-size: 14px; color: var(--ink-muted); font-weight: 500; }

  .pains { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 32px; border-top: 1px solid var(--line); }
  .pain { padding: 28px 24px 28px 0; border-bottom: 1px solid var(--line); display: flex; gap: 16px; align-items: flex-start; font-size: 16px; line-height: 1.5; }
  .pain .x { color: var(--gold); font-family: var(--font-serif); font-size: 14px; margin-top: 2px; }
  .role { margin-top: 48px; font-family: var(--font-serif); font-size: clamp(22px, 2.6vw, 32px); font-style: italic; line-height: 1.35; letter-spacing: -0.01em; max-width: 820px; }
  .role span { color: var(--gold); font-style: normal; font-family: var(--font-sans); font-weight: 500; }
  @media (max-width: 900px) { .pains { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .pains { grid-template-columns: 1fr; } }

  .offers-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 56px; flex-wrap: wrap; gap: 24px; }
  .offers-side { color: oklch(60% 0.01 260); font-size: 14px; max-width: 320px; }
  .offers { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1px; background: var(--line-dark); }
  .offer { background: var(--dark); padding: 40px 36px; display: flex; flex-direction: column; position: relative; }
  .offer.highlight { background: oklch(18% 0.02 255); }
  .offer.highlight::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--gold); }
  .offer-tag { font-size: 11px; color: oklch(55% 0.01 260); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px; }
  .highlight .offer-tag { color: var(--gold); }
  .offer h3 { font-family: var(--font-serif); font-size: 28px; font-weight: 400; color: white; margin-bottom: 16px; letter-spacing: -0.01em; line-height: 1.15; }
  .offer-pitch { font-size: 14px; color: oklch(65% 0.01 260); line-height: 1.6; margin-bottom: 28px; }
  .offer ul { list-style: none; margin-bottom: 32px; flex: 1; }
  .offer li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: oklch(75% 0.01 260); padding-bottom: 10px; line-height: 1.5; }
  .offer li span { color: var(--gold); font-size: 13px; margin-top: 2px; }
  .offer > a { color: white; font-size: 13px; font-weight: 500; text-decoration: none; padding-top: 16px; border-top: 1px solid var(--line-dark); }
  .highlight > a { color: var(--gold); }
  .offers-foot { margin-top: 40px; font-size: 13px; color: oklch(55% 0.01 260); text-align: center; }
  .offers-foot a { color: var(--gold); text-decoration: none; }
  @media (max-width: 600px) { .offer { padding: 32px 24px; } }

  .step { display: grid; grid-template-columns: 80px 180px 1fr; gap: 32px; padding: 32px 0; border-top: 1px solid var(--line); align-items: start; }
  .step-n { font-family: var(--font-serif); font-size: 36px; color: var(--gold); line-height: 1; }
  .step-delay { font-size: 11px; color: var(--ink-muted); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 4px; }
  .step-title { font-family: var(--font-serif); font-size: 24px; letter-spacing: -0.01em; }
  .step-desc { color: var(--ink-soft); font-size: 15px; line-height: 1.65; max-width: 560px; }
  @media (max-width: 720px) { .step { grid-template-columns: 1fr; gap: 12px; } }

  .results { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); }
  .result { background: var(--paper); padding: 36px 32px; display: flex; flex-direction: column; }
  .r-sector { font-size: 11px; color: var(--ink-muted); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 24px; }
  .r-metric { font-family: var(--font-serif); font-size: 44px; color: var(--gold); line-height: 1; margin-bottom: 12px; letter-spacing: -0.02em; }
  .r-label { font-size: 15px; font-weight: 500; margin-bottom: 16px; }
  .r-note { font-size: 13px; color: var(--ink-soft); line-height: 1.55; flex: 1; margin-bottom: 20px; }
  .r-client { font-size: 13px; font-weight: 600; padding-top: 16px; border-top: 1px solid var(--line); }
  @media (max-width: 1100px) { .results { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .results { grid-template-columns: 1fr; } }

  .adn { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; align-items: start; }
  .adn-left { position: sticky; top: 100px; }
  .adn-img { aspect-ratio: 16 / 10; background-size: cover; background-position: center 35%; border-radius: 4px; margin-bottom: 32px; border: 1px solid var(--line); box-shadow: 0 2px 8px oklch(0% 0 0 / 0.04); }
  .adn-credit { color: var(--ink-muted); font-size: 11px; font-style: italic; letter-spacing: 0.02em; margin-bottom: 28px; line-height: 1.4; }
  .adn-btn { display: inline-block; background: var(--ink); color: white; padding: 12px 22px; border-radius: 7px; text-decoration: none; font-size: 14px; font-weight: 500; transition: background 0.15s; }
  .adn-btn:hover { background: var(--gold); }
  .point { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .point:first-child { border-top: 1px solid var(--line); }
  .point:last-child { border-bottom: 0; }
  .point h3 { font-family: var(--font-serif); font-size: 22px; font-weight: 400; margin-bottom: 10px; letter-spacing: -0.01em; }
  .point p { font-size: 15px; color: var(--ink-soft); line-height: 1.65; }
  @media (max-width: 900px) { .adn { grid-template-columns: 1fr; gap: 40px; } .adn-left { position: static; } }

  .t-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 56px; flex-wrap: wrap; gap: 16px; }
  .t-arrow { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-dark); background: transparent; color: white; cursor: pointer; font-size: 16px; }
  .t-arrow:hover { border-color: white; }
  .t-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1px; background: var(--line-dark); }
  .t-quote { background: var(--dark); padding: 48px; }
  .t-quote blockquote { font-family: var(--font-serif); font-size: clamp(20px, 2.2vw, 30px); color: white; line-height: 1.4; margin-bottom: 40px; font-style: italic; }
  .t-name { font-size: 15px; font-weight: 600; color: white; margin-bottom: 2px; }
  .t-role { font-size: 13px; color: oklch(55% 0.01 260); }
  .t-list { background: oklch(14% 0.015 260); padding: 24px; display: flex; flex-direction: column; gap: 2px; }
  .t-item { background: transparent; border: none; padding: 12px 16px; cursor: pointer; text-align: left; border-radius: 6px; transition: background 0.15s; font: inherit; }
  .t-item .n { display: block; font-size: 13px; color: oklch(50% 0.01 260); line-height: 1.3; }
  .t-item .r { display: none; font-size: 11px; color: var(--gold); margin-top: 2px; }
  .t-item.active { background: oklch(20% 0.015 255); }
  .t-item.active .n { color: white; font-weight: 600; }
  .t-item.active .r { display: block; }
  @media (max-width: 768px) { .t-grid { grid-template-columns: 1fr; } .t-quote { padding: 32px 24px; } }

  .faq details { border-top: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; padding: 24px 36px 24px 0; position: relative; font-size: 16px; font-weight: 500; line-height: 1.4; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: 20px; font-size: 20px; color: var(--ink-muted); transition: transform 0.2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { padding-bottom: 24px; color: var(--ink-soft); line-height: 1.7; font-size: 15px; white-space: pre-line; }
</style>
